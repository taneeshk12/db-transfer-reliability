# Copy to .env and fill in. .env is gitignored — never commit it.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=dbtr
POSTGRES_PASSWORD=change_me
POSTGRES_DB=db_transfer
POSTGRES_HOST=localhost
# 5434 on the host so it doesn't clash with a local Postgres (5432) or other projects (5433)
POSTGRES_PORT=5434

# --- DB API Marketplace: Timetables API ---
# Create an application at https://developers.deutschebahn.com/db-api-marketplace,
# subscribe it to "Timetables", then copy the Client ID and API Key here.
DB_CLIENT_ID=
DB_API_KEY=
